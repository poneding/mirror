{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mirror",
  "version": "0.1.0-alpha.5",
  "identifier": "com.mirror.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:6477",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Mirror",
        "width": 1120,
        "height": 700,
        "minWidth": 640,
        "minHeight": 360,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data: media: http://media.localhost https://media.localhost",
        "media-src": "'self' media: http://media.localhost https://media.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Entertainment",
    "publisher": "Mirror",
    "shortDescription": "A clean, offline video player",
    "fileAssociations": [
      {
        "ext": ["mp4"],
        "name": "Mirror.MP4",
        "mimeType": "video/mp4",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["mkv"],
        "name": "Mirror.MKV",
        "mimeType": "video/x-matroska",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["webm"],
        "name": "Mirror.WebM",
        "mimeType": "video/webm",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["mov"],
        "name": "Mirror.MOV",
        "mimeType": "video/quicktime",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["avi"],
        "name": "Mirror.AVI",
        "mimeType": "video/x-msvideo",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["m4v"],
        "name": "Mirror.M4V",
        "mimeType": "video/x-m4v",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/poneding/mirror/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1MUFDMTlDMDQzNDc2QjcKUldTM2RqUUVuTUVhVllxdXJvUW9XckxtNmJhQnhLOGd6cDBTVFV1dXF2ak8wQmdNK2t1OEtXZksK"
    }
  }
}
